<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="waiter"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_waiter">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.dinesense.app.MainActivity"
            android:targetPackage="com.dinesense.app">
            <extra android:name="dinesense_path" android:value="/waiter" />
        </intent>
    </shortcut>
