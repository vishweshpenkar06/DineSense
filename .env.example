# Copy to .env (docker compose) and apps/web/.env.local (plain local dev).

# Postgres
POSTGRES_USER=dinesense
POSTGRES_PASSWORD=dinesense
POSTGRES_DB=dinesense
DATABASE_URL=postgresql://dinesense:dinesense@localhost:5432/dinesense?schema=public

# Auth
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-another-long-random-string
# Set true when staff use HTTPS (production/LAN). Keep false for http://localhost dev.
COOKIE_SECURE=false

# Vision service shared secret (Bearer token for /api/vision/*)
VISION_SHARED_SECRET=dev-vision-secret

# Dev console (/dev) and simulator endpoints. Never enable in production.
ENABLE_DEV_CONSOLE=true
VISION_URL=http://localhost:8100

# Vision service: true = generated demo videos in services/vision/demo (no cameras)
VISION_DEMO=false

# Public site address used by Caddy in later phases
SITE_ADDRESS=localhost
ACME_EMAIL=
